local function CreateESPContainer(model)
    local esp = {
        Model = model,
        BoxLines = {},
        CornerLines = {},
        HealthBG = Drawing.new("Line"),
        HealthBar = Drawing.new("Line"),
        Tracer = Drawing.new("Line"),
        NameTag = Drawing.new("Text"),
        SkeletonLines = {}
    }

    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible = false
        table.insert(esp.BoxLines, line)
    end

    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Visible = false
        table.insert(esp.CornerLines, line)
    end

    for i = 1, 15 do
        local line = Drawing.new("Line")
        line.Visible = false
        table.insert(esp.SkeletonLines, line)
    end

    esp.NameTag.Center = true
    esp.NameTag.Outline = true
    esp.NameTag.Size = 16
    esp.NameTag.Visible = false

    function esp:HideAll()
        for _, l in ipairs(self.BoxLines) do l.Visible = false end
        for _, l in ipairs(self.CornerLines) do l.Visible = false end
        for _, l in ipairs(self.SkeletonLines) do l.Visible = false end
        self.HealthBG.Visible = false
        self.HealthBar.Visible = false
        self.Tracer.Visible = false
        self.NameTag.Visible = false
    end

    function esp:Destroy()
        self:HideAll()
        for _, l in ipairs(self.BoxLines) do pcall(function() l:Remove() end) end
        for _, l in ipairs(self.CornerLines) do pcall(function() l:Remove() end) end
        for _, l in ipairs(self.SkeletonLines) do pcall(function() l:Remove() end) end
        pcall(function() self.HealthBG:Remove() end)
        pcall(function() self.HealthBar:Remove() end)
        pcall(function() self.Tracer:Remove() end)
        pcall(function() self.NameTag:Remove() end)
    end

    return esp
end

local function UpdateESP(esp, targetInfo)
    local model = esp.Model
    if not model or not model.Parent then
        esp:Destroy()
        return false
    end

    local masterEnabled = Toggles.Master_ESP_Enable and Toggles.Master_ESP_Enable.Value
    if not masterEnabled then
        esp:HideAll()
        return true
    end

    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head") or model.PrimaryPart

    if not root or not hum or hum.Health <= 0 then
        esp:HideAll()
        return true
    end

    local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then
        esp:HideAll()
        return true
    end

    local head = model:FindFirstChild("Head")
    local topPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
    local bottomPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.5, 0))

    local boxHeight = math.abs(topPos.Y - bottomPos.Y)
    local boxWidth = boxHeight * 0.65
    local boxPos = Vector2.new(rootPos.X - boxWidth / 2, topPos.Y)

    local boxThick = Options.Esp_BoxThickness and Options.Esp_BoxThickness.Value or 2
    local tracerThick = Options.Esp_TracerThickness and Options.Esp_TracerThickness.Value or 2
    local skelThick = Options.Esp_SkelThickness and Options.Esp_SkelThickness.Value or 2
    local textSize = Options.Esp_TextSize and Options.Esp_TextSize.Value or 16

    local boxEnabled = Toggles.Box_Enable and Toggles.Box_Enable.Value
    local boxStyle = Options.Box_Style and Options.Box_Style.Value or "2D Box"
    local boxColor = GetColor(Options.Box_Color and Options.Box_Color.Value)

    if boxEnabled then
        if boxStyle == "2D Box" then
            for _, l in ipairs(esp.CornerLines) do l.Visible = false end
            local p1, p2 = boxPos, boxPos + Vector2.new(boxWidth, 0)
            local p3, p4 = boxPos + Vector2.new(boxWidth, boxHeight), boxPos + Vector2.new(0, boxHeight)

            local lines = { {p1, p2}, {p2, p3}, {p3, p4}, {p4, p1} }
            for i, lineData in ipairs(lines) do
                local l = esp.BoxLines[i]
                l.Thickness = boxThick
                l.Color = boxColor
                l.From, l.To = lineData[1], lineData[2]
                l.Visible = true
            end
        elseif boxStyle == "2D Corner Box" then
            for _, l in ipairs(esp.BoxLines) do l.Visible = false end
            local cLen = boxWidth * 0.25
            local x1, y1 = boxPos.X, boxPos.Y
            local x2, y2 = boxPos.X + boxWidth, boxPos.Y + boxHeight

            local corners = {
                {Vector2.new(x1, y1), Vector2.new(x1 + cLen, y1)}, {Vector2.new(x1, y1), Vector2.new(x1, y1 + cLen)},
                {Vector2.new(x2, y1), Vector2.new(x2 - cLen, y1)}, {Vector2.new(x2, y1), Vector2.new(x2, y1 + cLen)},
                {Vector2.new(x1, y2), Vector2.new(x1 + cLen, y2)}, {Vector2.new(x1, y2), Vector2.new(x1, y2 - cLen)},
                {Vector2.new(x2, y2), Vector2.new(x2 - cLen, y2)}, {Vector2.new(x2, y2), Vector2.new(x2, y2 - cLen)}
            }

            for i, lineData in ipairs(corners) do
                local l = esp.CornerLines[i]
                l.Thickness = boxThick
                l.Color = boxColor
                l.From, l.To = lineData[1], lineData[2]
                l.Visible = true
            end
        end
    else
        for _, l in ipairs(esp.BoxLines) do l.Visible = false end
        for _, l in ipairs(esp.CornerLines) do l.Visible = false end
    end

    local healthEnabled = Toggles.Health_Enable and Toggles.Health_Enable.Value
    local healthPos = Options.Health_Position and Options.Health_Position.Value or "Left"

    if healthEnabled then
        local currentHealth = hum.Health
        local maxHealth = hum.MaxHealth > 0 and hum.MaxHealth or 100
        local healthPct = math.clamp(currentHealth / maxHealth, 0, 1)
        local bgFrom, bgTo, barFrom, barTo

        if healthPos == "Left" then
            local barX = boxPos.X - 6
            bgFrom = Vector2.new(barX, boxPos.Y)
            bgTo = Vector2.new(barX, boxPos.Y + boxHeight)
            barFrom = Vector2.new(barX, boxPos.Y + boxHeight)
            barTo = Vector2.new(barX, boxPos.Y + boxHeight - (boxHeight * healthPct))
        elseif healthPos == "Right" then
            local barX = boxPos.X + boxWidth + 6
            bgFrom = Vector2.new(barX, boxPos.Y)
            bgTo = Vector2.new(barX, boxPos.Y + boxHeight)
            barFrom = Vector2.new(barX, boxPos.Y + boxHeight)
            barTo = Vector2.new(barX, boxPos.Y + boxHeight - (boxHeight * healthPct))
        elseif healthPos == "Top" then
            local barY = boxPos.Y - 6
            bgFrom = Vector2.new(boxPos.X, barY)
            bgTo = Vector2.new(boxPos.X + boxWidth, barY)
            barFrom = Vector2.new(boxPos.X, barY)
            barTo = Vector2.new(boxPos.X + (boxWidth * healthPct), barY)
        elseif healthPos == "Bottom" then
            local barY = boxPos.Y + boxHeight + 6
            bgFrom = Vector2.new(boxPos.X, barY)
            bgTo = Vector2.new(boxPos.X + boxWidth, barY)
            barFrom = Vector2.new(boxPos.X, barY)
            barTo = Vector2.new(boxPos.X + (boxWidth * healthPct), barY)
        end

        esp.HealthBG.Visible = true
        esp.HealthBG.From = bgFrom
        esp.HealthBG.To = bgTo
        esp.HealthBG.Color = Color3.fromRGB(30, 30, 30)
        esp.HealthBG.Thickness = boxThick

        esp.HealthBar.Visible = true
        esp.HealthBar.From = barFrom
        esp.HealthBar.To = barTo
        esp.HealthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPct)
        esp.HealthBar.Thickness = boxThick
    else
        esp.HealthBG.Visible = false
        esp.HealthBar.Visible = false
    end

    local tracerEnabled = Toggles.Tracer_Enable and Toggles.Tracer_Enable.Value
    local tracerOrigin = Options.Tracer_Origin and Options.Tracer_Origin.Value or "Bottom"
    local tracerColor = GetColor(Options.Tracer_Color and Options.Tracer_Color.Value)

    if tracerEnabled then
        local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

        if tracerOrigin == "Bottom" then
            startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        elseif tracerOrigin == "Middle" then
            startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        elseif tracerOrigin == "Top" then
            startPos = Vector2.new(Camera.ViewportSize.X / 2, 0)
        elseif tracerOrigin == "Mouse" then
            startPos = UserInputService:GetMouseLocation()
        end

        esp.Tracer.Visible = true
        esp.Tracer.From = startPos
        esp.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
        esp.Tracer.Color = tracerColor
        esp.Tracer.Thickness = tracerThick
    else
        esp.Tracer.Visible = false
    end

    local tagEnabled = Toggles.Tags_Name and Toggles.Tags_Name.Value
    local tagColor = GetColor(Options.Tags_NameColor and Options.Tags_NameColor.Value)
    if tagEnabled then
        local hpVal = math.floor(hum.Health)
        esp.NameTag.Size = textSize
        esp.NameTag.Position = Vector2.new(rootPos.X, boxPos.Y - (textSize + 4))
        esp.NameTag.Text = string.format("%s [%d]", targetInfo.Name, hpVal)
        esp.NameTag.Color = tagColor
        esp.NameTag.Visible = true
    else
        esp.NameTag.Visible = false
    end

    local skelEnabled = Toggles.Skel_Enable and Toggles.Skel_Enable.Value
    local skelColor = GetColor(Options.Skel_Color and Options.Skel_Color.Value)
    if skelEnabled then
        local boneList = (hum.RigType == Enum.HumanoidRigType.R15) and R15_Bones or R6_Bones
        for i, pair in ipairs(boneList) do
            local partA = model:FindFirstChild(pair[1])
            local partB = model:FindFirstChild(pair[2])
            local line = esp.SkeletonLines[i]

            if partA and partB and line then
                local posA, visA = Camera:WorldToViewportPoint(partA.Position)
                local posB, visB = Camera:WorldToViewportPoint(partB.Position)

                if visA and visB then
                    line.Thickness = skelThick
                    line.Color = skelColor
                    line.From = Vector2.new(posA.X, posA.Y)
                    line.To = Vector2.new(posB.X, posB.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            elseif line then
                line.Visible = false
            end
        end
    else
        for _, l in ipairs(esp.SkeletonLines) do l.Visible = false end
    end

    return true
end

RunService.RenderStepped:Connect(function(deltaTime)
    ProcessHitboxExpander()

    local fovEnabled = Toggles.Combat_Fov_Enable and Toggles.Combat_Fov_Enable.Value
    local fovRadius = (Toggles.Combat_SilentAim_Enable and Toggles.Combat_SilentAim_Enable.Value and Options.Combat_SilentAim_FovRadius and Options.Combat_SilentAim_FovRadius.Value) or (Options.Combat_Fov_Radius and Options.Combat_Fov_Radius.Value or 80)
    local fovColor = Options.Combat_Fov_Color and Options.Combat_Fov_Color.Value or Color3.fromRGB(0, 255, 100)

    if fovEnabled and fovRadius > 0 then
        local size = fovRadius * 2
        FovFrame.Size = UDim2.new(0, size, 0, size)
        FovFrame.Position = UDim2.new(0, Camera.ViewportSize.X / 2, 0, Camera.ViewportSize.Y / 2)
        FovStroke.Color = fovColor
        FovFrame.Visible = true
    else
        FovFrame.Visible = false
    end

    if Toggles.Combat_Aimbot_Enable and Toggles.Combat_Aimbot_Enable.Value then
        local targetPart = GetBestTarget()
        if targetPart then
            local targetPos = targetPart.Position

            if Toggles.Combat_Aimbot_Prediction_Enable and Toggles.Combat_Aimbot_Prediction_Enable.Value then
                local predAmount = Options.Combat_Aimbot_Prediction_Amount and Options.Combat_Aimbot_Prediction_Amount.Value or 0.165
                local velocity = Vector3.zero
                
                if targetPart.AssemblyLinearVelocity then
                    velocity = targetPart.AssemblyLinearVelocity
                elseif targetPart.Parent and targetPart.Parent:FindFirstChild("HumanoidRootPart") then
                    velocity = targetPart.Parent.HumanoidRootPart.AssemblyLinearVelocity
                end
                
                targetPos = targetPos + (velocity * predAmount)
            end

            local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)

            if Toggles.Combat_Aimbot_Smooth_Enable and Toggles.Combat_Aimbot_Smooth_Enable.Value then
                local smoothValue = Options.Combat_Aimbot_Smooth_Amount and Options.Combat_Aimbot_Smooth_Amount.Value or 10
                local alpha = math.clamp(deltaTime * (60 / smoothValue), 0, 1)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
            else
                Camera.CFrame = targetCFrame
            end
        end
    end

    local validTargets = GetValidTargets()
    local currentModels = {}

    for _, targetInfo in ipairs(validTargets) do
        currentModels[targetInfo.Model] = true
        if not ActiveESP[targetInfo.Model] then
            ActiveESP[targetInfo.Model] = CreateESPContainer(targetInfo.Model)
        end
        UpdateESP(ActiveESP[targetInfo.Model], targetInfo)
    end

    for model, esp in pairs(ActiveESP) do
        if not currentModels[model] then
            esp:Destroy()
            ActiveESP[model] = nil
        end
    end
end)

