local RGB_Color = Color3.fromRGB(255, 0, 0)
task.spawn(function()
    local hue = 0
    local timer = 0
    while task.wait(0.03) do
        local speed = Options.RGB_Speed and Options.RGB_Speed.Value or 20
        local mode = Options.RGB_Mode and Options.RGB_Mode.Value or "Rainbow"
        local baseColor = Options.RGB_BaseColor and Options.RGB_BaseColor.Value or Color3.fromRGB(255, 0, 0)
        
        timer = timer + (speed / 100)
        hue = (hue + (speed / 1000)) % 1

        if mode == "Rainbow" then
            RGB_Color = Color3.fromHSV(hue, 1, 1)
        elseif mode == "Wave" then
            local wave = (math.sin(timer) + 1) / 2
            RGB_Color = Color3.fromHSV(wave, 1, 1)
        elseif mode == "Pulse" then
            local val = (math.sin(timer * 2) + 1) / 2
            local h, s, _ = baseColor:ToHSV()
            RGB_Color = Color3.fromHSV(h, s, math.clamp(val, 0.2, 1))
        elseif mode == "Cycle" then
            local cycleHue = (math.floor(timer) * 0.2) % 1
            RGB_Color = Color3.fromHSV(cycleHue, 1, 1)
        elseif mode == "Flash" then
            local isFlash = (math.sin(timer * 5) > 0)
            RGB_Color = isFlash and baseColor or Color3.fromRGB(20, 20, 20)
        end
    end
end)

