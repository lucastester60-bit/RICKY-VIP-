local function IsFriend(player)
    if not player or not player:IsA("Player") then return false end
    if player == LocalPlayer then return true end
    return LocalPlayer:IsFriendsWith(player.UserId)
end

local function IsSameTeam(player)
    if not player or not player:IsA("Player") then return false end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team == player.Team
    end
    return false
end

local function IsKnockedOrDead(model)
    if not model then return true end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end

    if model:FindFirstChild("KO") or model:FindFirstChild("Knocked") or model:FindFirstChild("IsDead") then
        return true
    end
    if hum:GetState() == Enum.HumanoidStateType.Ragdoll or hum:GetState() == Enum.HumanoidStateType.Physics then
        return true
    end
    return false
end

local function GetValidTargets()
    local targets = {}
    local includeNPCs = Toggles.Vis_IncludeNPCs and Toggles.Vis_IncludeNPCs.Value
    local friendCheck = Toggles.Vis_FriendCheck and Toggles.Vis_FriendCheck.Value
    local teamCheck = Toggles.Combat_TeamCheck and Toggles.Combat_TeamCheck.Value
    local ignoreKnocked = Toggles.Combat_IgnoreKnocked and Toggles.Combat_IgnoreKnocked.Value
    local maxDist = Options.Vis_MaxDistance and Options.Vis_MaxDistance.Value or 1000

    local playerModels = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            playerModels[player.Character] = true
            
            local isTeam = teamCheck and IsSameTeam(player)
            local isFriend = friendCheck and IsFriend(player)

            if not (isTeam or isFriend) then
                local model = player.Character
                local hum = model:FindFirstChildOfClass("Humanoid")
                local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model.PrimaryPart

                if hum and root and hum.Health > 0 then
                    if not (ignoreKnocked and IsKnockedOrDead(model)) then
                        local dist = (root.Position - Camera.CFrame.Position).Magnitude
                        if dist <= maxDist then
                            table.insert(targets, { Model = model, Player = player, Name = player.DisplayName or player.Name })
                        end
                    end
                end
            end
        end
    end

    if includeNPCs then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj ~= LocalPlayer.Character and not playerModels[obj] then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    if not (ignoreKnocked and IsKnockedOrDead(obj)) then
                        local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Head")
                        if root then
                            local dist = (root.Position - Camera.CFrame.Position).Magnitude
                            if dist <= maxDist then
                                table.insert(targets, { Model = obj, Player = nil, Name = obj.Name })
                            end
                        end
                    end
                end
            end
        end
    end

    return targets
end

local function IsVisible(pos, wallCheckEnabled)
    if not wallCheckEnabled then return true end
    local origin = Camera.CFrame.Position
    local dir = (pos - origin).Unit * (pos - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, dir, params)
    if not result then return true end
    return (result.Position - pos).Magnitude < 3
end

local function GetSilentTarget()
    if not (Toggles.Combat_SilentAim_Enable and Toggles.Combat_SilentAim_Enable.Value) then return nil end

    local targetPartName = Options.Combat_SilentAim_Target and Options.Combat_SilentAim_Target.Value or "Head"
    local fovRadius = Options.Combat_SilentAim_FovRadius and Options.Combat_SilentAim_FovRadius.Value or 150
    local wallCheck = Toggles.Combat_SilentAim_WallCheck and Toggles.Combat_SilentAim_WallCheck.Value
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    local closestPart = nil
    local shortestDistance = fovRadius

    for _, targetInfo in ipairs(GetValidTargets()) do
        local model = targetInfo.Model
        local part = model:FindFirstChild(targetPartName) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        if part then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                if distFromCenter < shortestDistance then
                    if IsVisible(part.Position, wallCheck) then
                        shortestDistance = distFromCenter
                        closestPart = part
                    end
                end
            end
        end
    end
    return closestPart
end

