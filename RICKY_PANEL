task.spawn(function()
    while task.wait(1) do
        if remainingSecondsAPI < 99990000 then
            if remainingSecondsAPI > 0 then
                remainingSecondsAPI = remainingSecondsAPI - 1
            end
            local d = math.floor(remainingSecondsAPI / 86400)
            local h = math.floor((remainingSecondsAPI % 86400) / 3600)
            local m = math.floor((remainingSecondsAPI % 3600) / 60)
            local s = remainingSecondsAPI % 60
            LiveTimeLabel:SetText(string.format("Restante: %d Dias, %02d:%02d:%02d", d, h, m, s))
        else
            LiveTimeLabel:SetText("Tempo Restante: Vitalício (PERM)")
        end
    end
end)

