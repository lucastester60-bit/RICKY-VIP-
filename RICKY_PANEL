local OriginalHitboxState = {}

local function ResetHitboxes()
    for part, state in pairs(OriginalHitboxState) do
        if part and part.Parent then
            pcall(function()
                part.Size = state.Size
                part.Transparency = state.Transparency
                part.Material = state.Material
                part.Reflectance = state.Reflectance
                part.CanCollide = state.CanCollide
                part.Massless = state.Massless
            end)
        end
    end
    table.clear(OriginalHitboxState)
end

local function GetTargetPartsForHitbox(model, targetType)
    local parts = {}
    if not model then return parts end

    if targetType == "All Parts" then
        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("BasePart") then
                table.insert(parts, child)
            end
        end
    elseif targetType == "Head" then
        local p = model:FindFirstChild("Head")
        if p then table.insert(parts, p) end
    elseif targetType == "HumanoidRootPart" then
        local p = model:FindFirstChild("HumanoidRootPart")
        if p then table.insert(parts, p) end
    elseif targetType == "Torso" then
        local names = {"Torso", "UpperTorso", "LowerTorso"}
        for _, name in ipairs(names) do
            local p = model:FindFirstChild(name)
            if p then table.insert(parts, p) end
        end
    elseif targetType == "Left Arm" then
        local names = {"Left Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand"}
        for _, name in ipairs(names) do
            local p = model:FindFirstChild(name)
            if p then table.insert(parts, p) end
        end
    elseif targetType == "Right Arm" then
        local names = {"Right Arm", "RightUpperArm", "RightLowerArm", "RightHand"}
        for _, name in ipairs(names) do
            local p = model:FindFirstChild(name)
            if p then table.insert(parts, p) end
        end
    elseif targetType == "Left Leg" then
        local names = {"Left Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot"}
        for _, name in ipairs(names) do
            local p = model:FindFirstChild(name)
            if p then table.insert(parts, p) end
        end
    elseif targetType == "Right Leg" then
        local names = {"Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
        for _, name in ipairs(names) do
            local p = model:FindFirstChild(name)
            if p then table.insert(parts, p) end
        end
    end

    return parts
end

local function ProcessHitboxExpander()
    local enabled = Toggles.Combat_Hitbox_Enable and Toggles.Combat_Hitbox_Enable.Value
    if not enabled then
        if next(OriginalHitboxState) ~= nil then
            ResetHitboxes()
        end
        return
    end

    local size = Options.Combat_Hitbox_Size and Options.Combat_Hitbox_Size.Value or 10
    local targetType = Options.Combat_Hitbox_Target and Options.Combat_Hitbox_Target.Value or "HumanoidRootPart"
    
    local activeParts = {}

    for _, targetInfo in ipairs(GetValidTargets()) do
        local model = targetInfo.Model
        local partsToExpand = GetTargetPartsForHitbox(model, targetType)

        for _, part in ipairs(partsToExpand) do
            if part:IsA("BasePart") then
                activeParts[part] = true

                if not OriginalHitboxState[part] then
                    OriginalHitboxState[part] = {
                        Size = part.Size,
                        Transparency = part.Transparency,
                        Material = part.Material,
                        Reflectance = part.Reflectance,
                        CanCollide = part.CanCollide,
                        Massless = part.Massless
                    }
                end

                pcall(function()
                    part.Size = Vector3.new(size, size, size)
                    part.Transparency = 1
                    part.Material = Enum.Material.Glass
                    part.Reflectance = 0
                    part.CanCollide = false
                    part.Massless = true
                end)
            end
        end
    end

    for part, state in pairs(OriginalHitboxState) do
        if not activeParts[part] then
            if part and part.Parent then
                pcall(function()
                    part.Size = state.Size
                    part.Transparency = state.Transparency
                    part.Material = state.Material
                    part.Reflectance = state.Reflectance
                    part.CanCollide = state.CanCollide
                    part.Massless = state.Massless
                end)
            end
            OriginalHitboxState[part] = nil
        end
    end
end

local function GetBestTarget()
    local bestTargetPart = nil
    local bestDot = -1
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local targetPartName = Options.Combat_Aimbot_Target and Options.Combat_Aimbot_Target.Value or "Head"
    local maxDist = Options.Combat_Aimbot_MaxDistance and Options.Combat_Aimbot_MaxDistance.Value or 250
    local fovRadius = Options.Combat_Fov_Radius and Options.Combat_Fov_Radius.Value or 80
    local wallCheck = Toggles.Combat_Aimbot_WallCheck and Toggles.Combat_Aimbot_WallCheck.Value

    for _, targetInfo in ipairs(GetValidTargets()) do
        local model = targetInfo.Model
        local part = model:FindFirstChild(targetPartName) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
        if part then
            local dist = (part.Position - Camera.CFrame.Position).Magnitude
            if dist <= maxDist and IsVisible(part.Position, wallCheck) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                    local distFromCenter = (screenVec - screenCenter).Magnitude

                    if distFromCenter <= fovRadius then
                        local dir = (part.Position - Camera.CFrame.Position).Unit
                        local dot = Camera.CFrame.LookVector:Dot(dir)
                        if dot > bestDot then
                            bestDot = dot
                            bestTargetPart = part
                        end
                    end
                end
            end
        end
    end
    return bestTargetPart
end

